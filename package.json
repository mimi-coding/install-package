{
  "name": "kontratpay-admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev",
    "prepare": "husky",
    "test": "vitest run",
    "build": "next build",
    "start": "next start",
    "changeset": "changeset",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "lint": "NODE_OPTIONS='--max-old-space-size=4096' eslint --cache src/",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check:cloudflare": "wrangler deploy --dry-run",
    "check:cycles": "madge --circular --warning src",
    "sentry:upload": "sentry-cli sourcemaps inject --org $SENTRY_ORG --project $SENTRY_PROJECT .next/server && sentry-cli sourcemaps upload --org $SENTRY_ORG --project $SENTRY_PROJECT --dist $VERCEL_GIT_COMMIT_SHA .next/server"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@tanstack/react-query": "^5.102.5",
    "antd": "^6.6.1",
    "axios": "^1.19.0",
    "formik": "^2.4.9",
    "jose": "^6.2.10",
    "motion": "^12.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yup": "^1.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@next/bundle-analyzer": "^16.3.3",
    "@opennextjs/cloudflare": "^1.20.4",
    "@playwright/test": "^1.45.0",
    "@sentry/cli": "^3.7.0",
    "@sentry/nextjs": "^10.72.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "madge": "^8.0.0",
    "next-intl": "^4.14.1",
    "prettier": "^3.9.6",
    "rate-limiter-flexible": "^11.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
